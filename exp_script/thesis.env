# Paths can be absolute or relative to the repository root.
VENV_DIR=${VENV_DIR:-.venv}
LOONGSERVE_TRACE_JSONL=${LOONGSERVE_TRACE_JSONL:-data/loongserve_mixed_65k.jsonl}
BASE_EXPERIMENT_NAME=${BASE_EXPERIMENT_NAME:-spanmux_thesis_65k_100req}
MODEL_NAME=${MODEL_NAME:-meta-llama/Llama-3.2-1B-Instruct}

BENCHMARK_MODE=full
BENCHMARK_VARIANTS=${BENCHMARK_VARIANTS:-"native_40sm_chunked baseline_plus dynamic_hbm_serialized_fullsm dynamic_hbm_srpt full_vendor_v8"}
ISOLATION_GUARDED_2K_COMPARISON=1
ISOLATION_MATCHED_COMPARISON=1
ISOLATION_BATCH2_PD11_COMPARISON=0
WORKLOAD=LOONGSERVE
LOONGSERVE_TERMINATION_MODE=requests
LOONGSERVE_REQUEST_LIMIT=${LOONGSERVE_REQUEST_LIMIT:-100}
LOONGSERVE_ARRIVAL_TIME_SCALE=1
LOONGSERVE_TIME_LIMIT_SEC=0
LOONGSERVE_TIME_LIMIT_MODE=drain
REQUEST_TIMEOUT_SEC=28800
SERVER_READY_TIMEOUT_SEC=900
WARMUP_COUNT=1
WARMUP_OUTPUT_TOKENS=8
WARMUP_COOLDOWN_SEC=3

KV_CACHE_MEMORY_BYTES=2147483648
VLLM_NUM_GPU_BLOCKS_OVERRIDE=
VLLM_MAX_MODEL_LEN=65536
VLLM_MAX_NUM_SEQS=100
VLLM_MAX_NUM_BATCHED_TOKENS=16384
VLLM_LONG_PREFILL_TOKEN_THRESHOLD=2048
PREFILL_CHUNK_TOKENS=2048
VLLM_ISOLATION_PREFILL_BATCH_MAX_REQUESTS=0
VLLM_ISOLATION_DECODE_BATCH_MAX_REQUESTS=0
BENCHMARK_CUDAGRAPH=1
BENCHMARK_CUDAGRAPH_MODE=FULL_AND_PIECEWISE

PD_SM_PROFILES=0/40,30/10,32/8,34/6,36/4,38/2,40/0
PD_DYNAMIC_SM_POLICY=tbt_slo_feedback
DYNAMIC_HBM_PREFILL_SCHEDULING_POLICY=fcfs
DYNAMIC_HBM_CONTENTION_MODE=guard_wait
FULL_VENDOR_V8_PREFILL_SCHEDULING_POLICY=srpt
FULL_VENDOR_V8_RESIDENCY_VICTIM_POLICY=scheduled_prefill_fit
FULL_VENDOR_V8_SCHEDULED_PREFILL_FIT_CAPACITY_FRACTION=0.98
FULL_VENDOR_V8_THROUGHPUT_OPTIMIZATIONS=1
VLLM_PD_EVAL_PHASE_DEPTH_ENABLED=1
VLLM_PD_EVAL_PREFILL_INFLIGHT_DEPTH=1
VLLM_PD_EVAL_DECODE_INFLIGHT_DEPTH=1
VLLM_PD_EVAL_GLOBAL_INFLIGHT_DEPTH=2
VLLM_PD_EVAL_PHASE_SYNC_SAMPLE_OUTPUT=0
VLLM_PD_EVAL_LAYERWISE_PROFILE_HANDOFF=1
VLLM_TTFT_LAYERWISE_PREFILL_GROUP_LAYERS=2
VLLM_PD_PREFILL_CHAIN_MAX_LOOKAHEAD_TOKENS=0
VLLM_PD_PREFILL_WORKSPACE_ENABLED=1
VLLM_PD_PREFILL_WORKSPACE_MAX_TOKENS=16384
VLLM_PD_PREFILL_WORKSPACE_SLOTS=1
VLLM_PD_PREFILL_WORKSPACE_STRICT=1
VLLM_KV_RETENTION_PARKED_MAX_BATCHES=1
VLLM_KV_RETENTION_PARKED_GPU_BYTES=268435456
VLLM_ISOLATION_HBM_COMPLETION_GUARD=1
VLLM_ISOLATION_MEMORY_OPTIMIZATIONS=1
VLLM_ISOLATION_EXECUTION_OPTIMIZATIONS=1
VLLM_ISOLATION_PREFILL_WORKSPACE_RIGHTSIZE=0
VLLM_ISOLATION_RING_WORKSPACE_SHARING=0
VLLM_ISOLATION_STARTUP_CACHE_TRIM=0
VLLM_ISOLATION_STARTUP_MEMORY_AUDIT=0
VLLM_ISOLATION_BOUNDED_PREFILL_PLANNING=0
# Enabled for SpanMux by the case-scoped launcher, following real22.
VLLM_ISOLATION_LOGICAL_RELEASE_READINESS=1
VLLM_VIRTUAL_CONTEXT_DECODE_CONTINUATION_ROLLING_RECLAIM=0
VLLM_PD_EVAL_RING_STREAMING_WAVE_GROUPS=1
VLLM_PD_EVAL_RING_COMPUTE_GROUP_TOKENS=2048
VLLM_PD_EVAL_RING_BATCHED_PARTIAL=0
VLLM_PD_EVAL_DRAM_REGISTER_DIRECT_MULTICOPY=1
VLLM_PD_EVAL_RELOAD_DIRECT_MULTICOPY=1
VLLM_PD_EVAL_RELOAD_STAGING_SCATTER=0
VLLM_PD_EVAL_RELOAD_FUSED_SCATTER=0
VLLM_PD_EVAL_VERIFY_DIRECT_OPS=1

ENABLE_DMON=${ENABLE_DMON:-1}
ENABLE_LIGHTWEIGHT_TIMELINE_TRACE=1
ITERATION_TRACE_SAMPLE_EVERY_N=${ITERATION_TRACE_SAMPLE_EVERY_N:-100}
ENABLE_SCHEDULER_TIMING_TRACE=${ENABLE_SCHEDULER_TIMING_TRACE:-0}
ENABLE_PD_CUDA_EVENT_TRACE=${ENABLE_PD_CUDA_EVENT_TRACE:-0}
ENABLE_FULL_ITERATION_TRACE=${ENABLE_FULL_ITERATION_TRACE:-0}
ENABLE_PD_EXECUTOR_DEBUG=${ENABLE_PD_EXECUTOR_DEBUG:-0}
GENERATE_ABCD=0
KILL_EXISTING_PORT_OWNER=0
